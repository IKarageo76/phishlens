# Copy to .env and fill in what you have. Every key is optional:
# a missing key means that source is shown as "Not checked".

# --- Intelligence sources ---
VT_API_KEY=            # https://www.virustotal.com (free public key: personal / non-commercial use only)
ABUSEIPDB_API_KEY=     # https://www.abuseipdb.com (free: 1,000 checks/day)
URLSCAN_API_KEY=       # https://urlscan.io (free key; search only, never auto-submits)
ABUSECH_AUTH_KEY=      # https://auth.abuse.ch (free; covers URLhaus, ThreatFox, MalwareBazaar)
HIBP_API_KEY=          # https://haveibeenpwned.com/API/Key (paid)

# --- Behaviour ---
PROTECTED_DOMAINS=     # your own / client domains for lookalike detection, comma separated
PRIVACY_MODE=false     # true = never send full email addresses to third parties
UNSHORTEN_ENABLED=false  # true = follow short links with HEAD requests (contacts the shortener)
VT_MAX_LOOKUPS_PER_ANALYSIS=4
MAX_URLS_PER_ANALYSIS=15
RETENTION_DAYS=30
MAX_UPLOAD_MB=25
